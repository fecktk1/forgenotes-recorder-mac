<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Applied to the Electron helper processes (Renderer, GPU, Plugin, and the plain
       Helper that runs Chromium's audio service). The renderer runs V8 and calls
       getUserMedia; the audio service is the process that opens the microphone and, on
       macOS 14.2 and later, the Core Audio tap for call audio. Both need the same grants
       as the main bundle. Deliberately NOT including com.apple.security.inherit:
       that is an App Sandbox key, and this is a Developer ID build with Hardened Runtime
       but no sandbox. Including it makes codesign fail. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
